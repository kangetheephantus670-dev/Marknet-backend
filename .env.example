# ---- Server ----
PORT=4000
# Public HTTPS base URL where THIS backend is reachable (needed for the M-Pesa callback).
# During local testing, use an ngrok URL. In production, use your real domain.
PUBLIC_BASE_URL=https://api.marknet.co.ke

# ---- M-Pesa Daraja (Safaricom) ----
# Get these from https://developer.safaricom.co.ke after creating an app.
MPESA_ENV=sandbox
# sandbox | production
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
# Paybill or Till number (Business Short Code)
MPESA_SHORTCODE=174379
# For sandbox, 174379 is Safaricom's public test Paybill. Use your own in production.
MPESA_PASSKEY=your_lipa_na_mpesa_online_passkey
# Type: CustomerPayBillOnline (paybill) or CustomerBuyGoodsOnline (till number)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# ---- MikroTik RouterOS API ----
MIKROTIK_HOST=192.168.88.1
MIKROTIK_USER=api-user
MIKROTIK_PASSWORD=change_me
MIKROTIK_PORT=8728
# Name of the hotspot server profile that new users should be added under
MIKROTIK_HOTSPOT_SERVER=hotspot1

# ---- Admin ----
# Simple shared secret to protect admin endpoints (e.g. manual voucher lookup)
ADMIN_API_KEY=change_this_to_something_long_and_random
